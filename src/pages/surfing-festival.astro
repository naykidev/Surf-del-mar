---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollWaves from '../components/ScrollWaves.astro';
import WaveSurfer from '../components/WaveSurfer.astro';
import PirateShip from '../components/PirateShip.astro';
import Lighthouse from '../components/Lighthouse.astro';
---

<BaseLayout
	title="Surfing Festival"
	description="Celebrate Del Mar's surfing heritage and the culture of the endless summer."
	pageKey="surfing-festival"
>
	<section class="hero hero-sunset-bg">
		<div class="hero-content hero-entrance">
			<h1 class="hero-title" data-editable="festival.hero.title">ABOUT SURF DEL MAR FESTIVAL</h1>
			<p class="tagline hero-tagline" data-editable="festival.hero.tagline">Celebrate the waves, the culture, and the spirit of Del Mar.</p>
		</div>
	</section>
	<div class="wave-wrap wave-hero hero-sunset-bg" id="festival-wave-wrap">
		<ScrollWaves variant="light" />
		<WaveSurfer />
		<PirateShip />
		<Lighthouse toggleTargetId="festival-wave-wrap" />
	</div>

	<section class="festival-content">
		<div class="container">
			<div class="photo-layout-split">
				<article class="event-card event-card-intro">
					<p class="festival-intro" data-editable="festival.intro">
						SURF DEL MAR FESTIVAL is presented by the Del Mar Historical Society as part of its ongoing mission to preserve and celebrate the history and culture of our unique seaside community, and especially to honor the many people who have helped shape the culture and spirit of surfing over the years. At the heart of the festival is a multi-generational Surfers Reunion, bringing together people who rode Del Mar's waves in the 1950s and 60s—and even earlier— alongside today's surfers and the next generations to follow.
					</p>
				</article>
				<figure class="festival-vintage-photo photo-angled-right">
					<div class="photo-frame">
						<img src="/1934.png" alt="Del Mar surf history, 1934" class="festival-vintage-img" width="800" height="533" />
						<div class="tape-element"></div>
					</div>
					<figcaption class="festival-vintage-caption">Photo courtesy of Jim Lischer.</figcaption>
				</figure>
			</div>
			<h2 class="festival-subhead" data-editable="festival.subhead">SURF DEL MAR FESTIVAL brings together many aspects of surf culture in one vibrant, festive event:</h2>
			<div class="event-cards">
				<article class="event-card event-card-vintage" data-event-id="surfers-reunion" role="button" tabindex="0" aria-haspopup="dialog" aria-label="View Surfers Reunion schedule">
					<div class="event-card-photo">
						<div class="photo-frame photo-frame-with-caption">
							<img src="/festival/surfers-reunion.png" alt="Surfers Reunion — Woody Station Wagons and the Mar Dels" class="festival-vintage-img festival-portrait-img" width="682" height="1024" />
							<p class="event-card-photo-caption" data-editable="festival.events.surfers-reunion.caption"></p>
						</div>
					</div>
					<h3 data-editable="festival.events.surfers-reunion.title">Surfers Reunion</h3>
					<p data-editable="festival.events.surfers-reunion.description">Celebrating decades of Del Mar surf history with classic Woody wagons, live music by the Mar Dels, and more</p>
					<span class="event-card-hint">View schedule</span>
				</article>
				<article class="event-card event-card-vintage" data-event-id="opening-night" role="button" tabindex="0" aria-haspopup="dialog" aria-label="View Opening Night Reunion schedule">
					<div class="event-card-photo">
						<div class="photo-frame photo-frame-with-caption">
							<img src="/festival/opening-night-reunion.png" alt="Opening Night Reunion — Peter Sprague and his group at Del Mar Plaza" class="festival-vintage-img festival-portrait-img" width="682" height="1024" />
							<p class="event-card-photo-caption" data-editable="festival.events.opening-night.caption"></p>
						</div>
					</div>
					<h3 data-editable="festival.events.opening-night.title">Opening Night Reunion</h3>
					<p data-editable="festival.events.opening-night.description">Live music by Peter Sprague and Group at Del Mar Plaza, with Legends and Champions Awards Ceremony emceed by Jim Kempton</p>
					<span class="event-card-hint">View schedule</span>
				</article>
				<article class="event-card event-card-vintage" data-event-id="film-festival" role="button" tabindex="0" aria-haspopup="dialog" aria-label="View Film Festival schedule">
					<div class="event-card-photo">
						<div class="photo-frame photo-frame-with-caption">
							<img src="/festival/film-festival.png" alt="Film Festival" class="festival-vintage-img festival-portrait-img" width="682" height="1024" />
							<p class="event-card-photo-caption" data-editable="festival.events.film-festival.caption"></p>
						</div>
					</div>
					<h3 data-editable="festival.events.film-festival.title">Film Festival</h3>
					<p data-editable="festival.events.film-festival.description">In collaboration with the California Surf Museum—featuring short surfing films highlighted by Bustin' Down The Door with Shaun Tomson Q&A</p>
					<span class="event-card-hint">View schedule</span>
				</article>
				<article class="event-card event-card-vintage" data-event-id="book-fair" role="button" tabindex="0" aria-haspopup="dialog" aria-label="View Surfwriter's Book Fair schedule">
					<div class="event-card-photo">
						<div class="photo-frame photo-frame-with-caption">
							<img src="/festival/surfwriters-book-fair.png" alt="Surfwriter's Book Fair" class="festival-vintage-img festival-portrait-img" width="682" height="1024" />
							<p class="event-card-photo-caption" data-editable="festival.events.book-fair.caption"></p>
						</div>
					</div>
					<h3 data-editable="festival.events.book-fair.title">Surfwriter's Book Fair</h3>
					<p data-editable="festival.events.book-fair.description">In collaboration with Camino Books of Del Mar—featuring top surfing writers and photographers</p>
					<span class="event-card-hint">View schedule</span>
				</article>
				<article class="event-card event-card-vintage" data-event-id="art-walk" role="button" tabindex="0" aria-haspopup="dialog" aria-label="View Art Walk schedule">
					<div class="event-card-photo">
						<div class="photo-frame photo-frame-with-caption">
							<img src="/festival/art-walk.png" alt="Art Walk" class="festival-vintage-img festival-portrait-img" width="682" height="1024" />
							<p class="event-card-photo-caption" data-editable="festival.events.art-walk.caption"></p>
						</div>
					</div>
					<h3 data-editable="festival.events.art-walk.title">Art Walk</h3>
					<p data-editable="festival.events.art-walk.description">Featuring some of the area's best known surfing artists including Kevin Anderson, Wade Koniakowsky, Sarah O'Connor, Michael Leyva and others</p>
					<span class="event-card-hint">View schedule</span>
				</article>
				<article class="event-card event-card-vintage" data-event-id="student-art-walk" role="button" tabindex="0" aria-haspopup="dialog" aria-label="View Student Art Walk schedule">
					<div class="event-card-photo">
						<div class="photo-frame photo-frame-with-caption">
							<img src="/festival/student-art-walk.png" alt="Student Art Walk" class="festival-vintage-img festival-portrait-img" width="682" height="1024" />
							<p class="event-card-photo-caption" data-editable="festival.events.student-art-walk.caption"></p>
						</div>
					</div>
					<h3 data-editable="festival.events.student-art-walk.title">Student Art Walk</h3>
					<p data-editable="festival.events.student-art-walk.description">Original artwork by students from Torrey Pines High School and Earl Warren Middle School, plus an on-site art table for young artists</p>
					<span class="event-card-hint">View schedule</span>
				</article>
				<article class="event-card event-card-vintage event-card-advocacy" data-event-id="sustainability" role="button" tabindex="0" aria-haspopup="dialog" aria-label="View Surfing and Sustainability Climate Symposium schedule">
					<div class="event-card-photo">
						<div class="photo-frame photo-frame-with-caption">
							<img src="/festival/sustainability-symposium.png" alt="Surfing and Sustainability" class="festival-vintage-img festival-portrait-img" width="682" height="1024" />
							<p class="event-card-photo-caption" data-editable="festival.events.sustainability.caption"></p>
						</div>
					</div>
					<h3 data-editable="festival.events.sustainability.title">Surfing and Sustainability Climate Symposium</h3>
					<p data-editable="festival.events.sustainability.description">Hear leaders in sustainability including Kevin Whildon of Sea Trees, Serge Dedina of WildCoast, speakers from Algenesis and others—moderated by Jeff Lehmann</p>
					<span class="event-card-hint">View schedule</span>
				</article>
				<article class="event-card event-card-vintage" data-event-id="woman-and-water" role="button" tabindex="0" aria-haspopup="dialog" aria-label="View Women on Waves schedule">
					<div class="event-card-photo">
						<div class="photo-frame photo-frame-with-caption">
							<img src="/festival/woman-and-water.png" alt="Women on Waves" class="festival-vintage-img festival-portrait-img" width="682" height="1024" />
							<p class="event-card-photo-caption" data-editable="festival.events.woman-and-water.caption"></p>
						</div>
					</div>
					<h3 data-editable="festival.events.woman-and-water.title">Women on Waves</h3>
					<p data-editable="festival.events.woman-and-water.description">Featuring exceptional women whose lives have been shaped by water—including Kim Dwinell, Sarah O'Connor, and Valerie & Victoria Du Prat. Sunday, October 11, 2026.</p>
					<span class="event-card-hint">View schedule</span>
				</article>
			</div>
			<article class="event-card event-card-free">
				<p class="festival-free" data-editable="festival.free">
					ALL EVENTS WILL BE FREE AND OPEN TO THE PUBLIC, WELCOMING RESIDENTS, VISITORS, SURFERS, FAMILIES AND ANYONE WHO SHARES A LOVE OF THE OCEAN
					<br /><br />
					(The Party at En Fuego Restaurant is open to everyone, but for food and drinks, you're on your own!)
				</p>
			</article>
			<h2 class="festival-tagline-heading" data-editable="festival.tagline-heading">HONORING THE PAST—INSPIRING THE FUTURE</h2>
			<article class="event-card">
				<p class="festival-outro" data-editable="festival.outro">
					By bringing together stories, art, film science and shared memories, SURF DEL MAR FESTIVAL honors the pioneers who helped shape surf culture while inspiring future generations to care for the coast, the ocean, and the traditions that grew from them.
				</p>
			</article>
		</div>
	</section>

	<div id="event-schedule-modal" class="event-schedule-modal" role="dialog" aria-labelledby="event-schedule-title" aria-modal="true" hidden>
		<div class="event-schedule-overlay" id="event-schedule-overlay"></div>
		<div class="event-schedule-box">
			<button type="button" class="event-schedule-close" id="event-schedule-close" aria-label="Close schedule">&times;</button>
			<p class="event-schedule-day" id="event-schedule-day"></p>
			<h2 id="event-schedule-title" class="event-schedule-title"></h2>
			<p class="event-schedule-blurb" id="event-schedule-blurb"></p>
			<div class="event-schedule-items" id="event-schedule-items"></div>
			<a href="/schedule/" class="event-schedule-full-link">See full festival schedule</a>
		</div>
	</div>

	<script>
		type ScheduleLine = { label: string; value: string };
		type ScheduleBlock = { heading?: string; lines: ScheduleLine[] };
		type EventSchedule = {
			title: string;
			day: string;
			blurb: string;
			blocks: ScheduleBlock[];
		};

		const EVENT_SCHEDULES: Record<string, EventSchedule> = {
			'surfers-reunion': {
				title: 'Surfers Reunion',
				day: 'Saturday, October 10',
				blurb: 'Celebrating decades of Del Mar surf history with classic Woody wagons, live music by the Mar Dels, The Endless Summer on the lawn, and more.',
				blocks: [
					{
						heading: "Surfer's Reunion",
						lines: [
							{ label: 'Venue', value: 'Powerhouse Park' },
							{ label: 'Time', value: '11:00 am to 9:30 pm' },
						],
					},
					{
						heading: 'Woody Wagon Parade Through Del Mar and Display',
						lines: [
							{ label: 'Venue', value: 'Del Mar Train Station' },
							{ label: 'Time', value: '12:00 pm to 3:00 pm' },
							{
								label: 'Details',
								value:
									'Woodies on display at the Del Mar Train Station from Noon to 3:00 pm. Festival Merchandise on sale at the Del Mar Train Station from Noon to 7:00 pm.',
							},
						],
					},
					{
						heading: 'Afternoon Concert with the Mar Dels',
						lines: [
							{ label: 'Venue', value: 'Powerhouse Park' },
							{ label: 'Time', value: '2:00 pm to 5:00 pm' },
						],
					},
					{
						heading: 'Showing of The Endless Summer',
						lines: [
							{ label: 'Venue', value: 'Powerhouse Park Lawn' },
							{ label: 'Time', value: 'Starts between 6:30 pm and 7:00 pm (as soon as it\'s dark)' },
							{ label: 'Note', value: 'Bring a Picnic!' },
						],
					},
				],
			},
			'opening-night': {
				title: 'Opening Night Reunion',
				day: 'Thursday, October 8',
				blurb: 'Meet legends from the surfing world at Del Mar Plaza—live music by Peter Sprague and Group, plus the Legends and Champions Awards Ceremony.',
				blocks: [
					{
						heading: 'Opening Reception: Surfers Meet and Greet',
						lines: [
							{ label: 'Venue', value: 'Del Mar Plaza' },
							{ label: 'Time', value: '3:00 pm to 7:30 pm' },
							{ label: 'Music', value: 'Music by Peter Sprague and Group, 5:00 pm to 7:00 pm' },
							{
								label: 'Awards',
								value:
									'Legends and Champions Awards Ceremony, emceed by Jim Kempton of the California Surf Museum, 5:30 pm to 6:00 pm',
							},
							{
								label: 'Details',
								value: 'Meet legends from the surfing world: surfers, authors, board shapers and more!',
							},
						],
					},
				],
			},
			'film-festival': {
				title: 'Film Festival',
				day: 'Friday, October 9',
				blurb: "In collaboration with the California Surf Museum—featuring short surfing films highlighted by Shaun Tomson's Bustin' Down The Door with Q&A to follow.",
				blocks: [
					{
						heading: 'Surfing Film Festival',
						lines: [
							{ label: 'Venue', value: "St Peter's Hall" },
							{ label: 'Collaboration', value: 'In collaboration with the California Surf Museum' },
							{
								label: 'Featuring',
								value:
									"Some of the best short surfing films, highlighted by a showing of legendary surfer Shaun Tomson's film Bustin' Down The Door, with Q&A session with Shaun to follow.",
							},
							{ label: 'Daytime Films', value: '11:00 am to 4:30 pm' },
							{ label: 'Evening Session', value: '5:00 pm to 7:30 pm' },
							{ label: 'Note', value: 'Stay tuned for the exact schedule.' },
						],
					},
					{
						heading: 'Party Time at En Fuego Restaurant',
						lines: [
							{ label: 'Time', value: '5:00 pm to 9:00 pm' },
							{ label: 'Details', value: 'Featuring music by Tower 7 and fabulous Mexican food!' },
							{
								label: 'Note',
								value: "The party is open to everyone. For food and drinks, you're on your own!",
							},
						],
					},
				],
			},
			'book-fair': {
				title: "Surfwriter's Book Fair",
				day: 'Saturday & Sunday, October 10–11',
				blurb: 'In collaboration with Camino Books of Del Mar—featuring top surfing writers and photographers. Stay tuned for the exact schedule.',
				blocks: [
					{
						heading: 'Saturday, October 10',
						lines: [
							{ label: 'Venue', value: "L'Auberge Hotel Ruby Room and Patio" },
							{ label: 'Time', value: '10:00 am to 3:00 pm' },
							{
								label: 'Featuring',
								value:
									'Top surfing writers and photographers like Shaun Tomson, Chris Ahrens, Todd Glaser, Kim Dwinell and others.',
							},
							{
								label: 'Collaboration',
								value: 'In collaboration with Camino Books of Del Mar — stay tuned for the exact schedule.',
							},
						],
					},
					{
						heading: 'Sunday, October 11',
						lines: [
							{ label: 'Venue', value: "L'Auberge Hotel Ruby Room and Patio" },
							{ label: 'Time', value: '10:00 am to 3:00 pm' },
							{
								label: 'Featuring',
								value:
									'Legendary surf photographer Jeff Divine and photo editor Grant Ellis, launching the new book "Divine Surf."',
							},
							{
								label: 'Collaboration',
								value: 'In collaboration with Camino Books of Del Mar — stay tuned for the exact schedule.',
							},
						],
					},
				],
			},
			'art-walk': {
				title: 'Art Walk',
				day: 'Thursday, October 8',
				blurb: "Featuring some of the area's best known surfing artists.",
				blocks: [
					{
						lines: [
							{ label: 'Venue', value: "Del Mar Plaza's Canyon View Garden Patio" },
							{ label: 'Time', value: '1:00 pm to 6:30 pm' },
							{
								label: 'Featuring',
								value:
									"Some of the area's best known surfing artists including: Kevin Anderson, Wade Koniakowsky, Sarah O'Connor, Michael Leyva, Jesse Martin, Mac Hillenbrand, Ted Emerick, Andy Wright, Jim McConlogue and others.",
							},
						],
					},
				],
			},
			'student-art-walk': {
				title: 'Student Art Walk',
				day: 'Sunday, October 11',
				blurb: 'Original student artwork plus an on-site art table for young artists.',
				blocks: [
					{
						lines: [
							{ label: 'Venue', value: "L'Auberge/Jim Watkins Outdoor Amphitheater" },
							{ label: 'Time', value: '11:00 am to 3:00 pm' },
							{
								label: 'Details',
								value:
									'Featuring original art work created by students from Torrey Pines High School and Earl Warren Middle School. There will be an on-site art table for young artists to create their own projects.',
							},
						],
					},
				],
			},
			sustainability: {
				title: 'Surfing and Sustainability Climate Symposium',
				day: 'Thursday, October 8',
				blurb: 'Hear leaders in the field of sustainability. Moderated by Del Mar TV personality Jeff Lehmann. Stay tuned for schedule of speakers.',
				blocks: [
					{
						heading: 'Surfing and Sustainability Climate Symposium',
						lines: [
							{ label: 'Venue', value: "St. Peter's Parish Hall" },
							{ label: 'Time', value: '11:00 am to 4:00 pm' },
							{
								label: 'Details',
								value:
									'Hear leaders in the field of sustainability like Kevin Whildon of Sea Trees, Serge Dedina of WildCoast, speakers from Algenesis and others. Moderated by Del Mar TV personality Jeff Lehmann.',
							},
							{ label: 'Note', value: 'Stay tuned for schedule of speakers.' },
						],
					},
				],
			},
			'woman-and-water': {
				title: 'Women on Waves',
				day: 'Sunday, October 11',
				blurb: 'Featuring exceptional women whose lives have been shaped by water. Stay tuned for exact schedule.',
				blocks: [
					{
						heading: 'Women on Waves',
						lines: [
							{ label: 'Venue', value: "St Peter's Parish Hall and Patio" },
							{ label: 'Time', value: '1:00 pm to 8:00 pm' },
							{
								label: 'Details',
								value:
									"Featuring exceptional women whose lives have been shaped by water: speakers include, author Kim Dwinell, artist Sarah O'Connor, and meet the amazing mother/daughter team Valerie and Victoria Du Prat. During the week, Valerie is a scientist, and on the weekends she's a surfboard shaper. Daughter Victoria is a chamption teen surfer, riding the waves on boards her mother has created for her.",
							},
							{ label: 'Note', value: 'Stay tuned for exact schedule.' },
						],
					},
				],
			},
		};

		const modal = document.getElementById('event-schedule-modal');
		const overlay = document.getElementById('event-schedule-overlay');
		const closeBtn = document.getElementById('event-schedule-close');
		const dayEl = document.getElementById('event-schedule-day');
		const titleEl = document.getElementById('event-schedule-title');
		const blurbEl = document.getElementById('event-schedule-blurb');
		const itemsEl = document.getElementById('event-schedule-items');
		const cards = document.querySelectorAll<HTMLElement>('.event-card-vintage[data-event-id]');

		function esc(text: string): string {
			const d = document.createElement('div');
			d.textContent = text;
			return d.innerHTML;
		}

		function openEventSchedule(eventId: string) {
			const data = EVENT_SCHEDULES[eventId];
			if (!data || !modal || !dayEl || !titleEl || !blurbEl || !itemsEl) return;

			dayEl.textContent = data.day;
			titleEl.textContent = data.title;
			blurbEl.textContent = data.blurb;
			itemsEl.innerHTML = data.blocks
				.map((block) => {
					const heading = block.heading
						? `<h3 class="event-schedule-block-title">${esc(block.heading)}</h3>`
						: '';
					const lines = block.lines
						.map(
							(line) =>
								`<p class="event-schedule-line"><span class="event-schedule-label">${esc(line.label)}</span> ${esc(line.value)}</p>`
						)
						.join('');
					return `<div class="event-schedule-block">${heading}${lines}</div>`;
				})
				.join('');

			modal.hidden = false;
			document.body.style.overflow = 'hidden';
			closeBtn?.focus();
		}

		function closeEventSchedule() {
			if (!modal) return;
			modal.hidden = true;
			document.body.style.overflow = '';
		}

		cards.forEach((card) => {
			const eventId = card.dataset.eventId;
			if (!eventId) return;
			card.addEventListener('click', (e) => {
				if (
					document.body.classList.contains('admin-text-editable') &&
					(e.target as HTMLElement).closest('[data-editable]')
				) {
					return;
				}
				openEventSchedule(eventId);
			});
			card.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					openEventSchedule(eventId);
				}
			});
		});

		overlay?.addEventListener('click', closeEventSchedule);
		closeBtn?.addEventListener('click', closeEventSchedule);
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && modal && !modal.hidden) closeEventSchedule();
		});
	</script>
</BaseLayout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&display=swap');

	.hero {
		color: var(--color-cream);
		padding: 4rem 2rem;
		text-align: center;
	}

	.wave-wrap {
		position: relative;
		overflow: visible;
		min-height: 120px;
	}

	.wave-wrap :global(.wave-surfer-wrap) {
		transition: opacity 0.4s ease, visibility 0.4s ease;
	}
	:global(.wave-wrap.pirate-mode) :global(.wave-surfer-wrap) {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.hero-content {
		max-width: 700px;
		margin: 0 auto;
	}

	.hero h1 {
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 5vw, 4rem);
		font-weight: 600;
		letter-spacing: 0.02em;
		margin-bottom: 1rem;
		line-height: 1.2;
		white-space: nowrap;
	}

	.hero-title {
		animation: hero-fade-up 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}
	.hero-tagline {
		opacity: 0;
		animation: hero-fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards;
	}
	@keyframes hero-fade-up {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.tagline {
		font-size: clamp(1rem, 3vw, 1.25rem);
		opacity: 0.95;
		font-weight: 400;
