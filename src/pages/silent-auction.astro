---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollWaves from '../components/ScrollWaves.astro';
import WaveSurfer from '../components/WaveSurfer.astro';
import PirateShip from '../components/PirateShip.astro';
import Lighthouse from '../components/Lighthouse.astro';
---

<BaseLayout
	title="Silent Auction"
	description="Bid on unique surf memorabilia, art, and collectibles at the Surf Del Mar Festival Silent Auction."
	pageKey="silent-auction"
>
	<section class="hero hero-sunset-bg">
		<div class="hero-content hero-entrance">
			<h1 class="hero-title">SILENT AUCTION</h1>
			<p class="tagline hero-tagline">Rare surf memorabilia, artwork, and collectibles — bid to take home a piece of history.</p>
		</div>
	</section>
	<div class="wave-wrap wave-hero hero-sunset-bg" id="auction-wave-wrap">
		<ScrollWaves variant="light" />
		<WaveSurfer />
		<PirateShip />
		<Lighthouse toggleTargetId="auction-wave-wrap" />
	</div>

	<section class="auction-content">
		<div class="container">

			<p class="auction-intro">
				The Surf Del Mar Festival Silent Auction will be held on <strong>Saturday, October 10, 2026</strong> in Powerhouse Park under the Welcome/Information Canopy. Bid sheets will be available all afternoon. Bidding closes at <strong>5:30 pm</strong>, and the winners will be announced at <strong>6:00 pm</strong>. All proceeds support the Del Mar Historical Society and the Surfing Festival.
			</p>

			<h2 class="section-heading">AUCTION ITEMS</h2>

			<div class="items-grid">
				<article class="event-card auction-card">
					<div class="auction-photo">
						<img src="/auction/kevin-anderson-painting.jpg" alt="Original Surf Del Mar Festival painting by Kevin Anderson" width="768" height="1024" />
					</div>
					<div class="auction-lot">Lot 1</div>
					<h3 class="auction-item-title">Original Surf Del Mar Festival Painting</h3>
					<p class="auction-item-desc">An original painting by well-known artist Kevin Anderson, created for Surf Del Mar Festival.</p>
					<div class="auction-bid-row">
						<span class="auction-label">Reserve / Minimum Bid</span>
						<span class="auction-price">$4,000</span>
					</div>
				</article>
				<article class="event-card auction-card">
					<div class="auction-photo">
						<img src="/auction/hollingsworth-longboard.jpg" alt="Craig Hollingsworth longboard with art by Veronika Strachova" width="768" height="1024" />
					</div>
					<div class="auction-lot">Lot 2</div>
					<h3 class="auction-item-title">Craig Hollingsworth Longboard</h3>
					<p class="auction-item-desc">A Craig Hollingsworth longboard, with original art by Veronika Strachova.</p>
					<div class="auction-bid-row">
						<span class="auction-label">Reserve / Minimum Bid</span>
						<span class="auction-price">$2,000</span>
					</div>
				</article>
				<article class="event-card auction-card">
					<div class="auction-photo">
						<img src="/auction/hansen-longboard.jpg" alt="Don Hansen Cardiff 50-50 longboard" width="768" height="1024" />
					</div>
					<div class="auction-lot">Lot 3</div>
					<h3 class="auction-item-title">Don Hansen Longboard</h3>
					<p class="auction-item-desc">A Don Hansen longboard — By Hansen Cardiff, 50-50.</p>
					<div class="auction-bid-row">
						<span class="auction-label">Reserve / Minimum Bid</span>
						<span class="auction-price">$2,000</span>
					</div>
				</article>
				<article class="event-card auction-card">
					<div class="auction-photo">
						<img src="/auction/turf-club-suite.jpg" alt="Del Mar Thoroughbred Club Celebrity Suite invitation" width="768" height="1024" />
					</div>
					<div class="auction-lot">Lot 4</div>
					<h3 class="auction-item-title">Del Mar Turf Club Celebrity Suite</h3>
					<p class="auction-item-desc">Available any Sunday during the Winter 2026 Meet. Accommodates up to 40 guests.</p>
					<div class="auction-bid-row">
						<span class="auction-label">Reserve / Minimum Bid</span>
						<span class="auction-price">$1,000</span>
					</div>
				</article>
				<article class="event-card auction-card auction-card-wide">
					<div class="auction-photo auction-photo-wide">
						<img src="/auction/bullys-glass-panels.jpg" alt="Historic etched glass panels of racehorses from the original Bully's Restaurant in Del Mar" width="1024" height="768" />
					</div>
					<div class="auction-lot">Lot 5</div>
					<h3 class="auction-item-title">Three Historic Glass Panels</h3>
					<p class="auction-item-desc">Three historic glass panels featuring horses from the original Bully’s Restaurant in Del Mar.</p>
					<div class="auction-bid-row">
						<span class="auction-label">Reserve / Minimum Bid</span>
						<span class="auction-price">$15,000</span>
					</div>
				</article>
			</div>

			<article class="event-card info-card">
				<h3 class="info-title">How the Auction Works</h3>
				<ul class="info-list">
					<li>Browse items on display Saturday, October 10, in Powerhouse Park under the Welcome/Information Canopy.</li>
					<li>Write your name, contact info, and bid amount on the bid sheet beside each item. Bid sheets are available all afternoon.</li>
					<li>Bidding closes at 5:30 pm. The highest bid at closing time wins.</li>
					<li>Winners will be announced at 6:00 pm and must collect their item before the end of the event.</li>
				</ul>
			</article>

			<article class="event-card info-card">
				<h3 class="info-title">Also for Sale at the Train Station</h3>
				<p class="merchandise-note">
					There will be many other items for sale like Festival Posters, T-shirts, beach towels, vintage shirts, a women’s wetsuit, and more at the Del Mar Train Station across from the Park.
				</p>
			</article>

		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		color: var(--color-cream);
		padding: 4rem 2rem;
		text-align: center;
	}

	.wave-wrap {
		position: relative;
		overflow: visible;
		min-height: 120px;
	}

	.wave-wrap :global(.wave-surfer-wrap) {
		transition: opacity 0.4s ease, visibility 0.4s ease;
	}
	:global(.wave-wrap.pirate-mode) :global(.wave-surfer-wrap) {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.hero-content {
		max-width: 700px;
		margin: 0 auto;
	}

	.hero-title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.75rem);
		font-weight: 600;
		color: var(--color-cream);
		margin: 0 0 1rem;
		line-height: 1.2;
		animation: hero-fade-up 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}

	.hero-tagline {
		font-size: 1.2rem;
		opacity: 0;
		font-weight: 400;
		animation: hero-fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards;
	}

	@keyframes hero-fade-up {
		from { opacity: 0; transform: translateY(30px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	.auction-content {
		position: relative;
		z-index: 1;
		padding: 4rem 2rem;
		background: linear-gradient(180deg, var(--color-sand) 0%, var(--color-foam) 100%);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4);
	}

	.container {
		max-width: 900px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.auction-intro {
		font-family: var(--font-body);
		font-size: 1.0625rem;
		color: var(--color-ink);
		line-height: 1.75;
		max-width: 720px;
	}

	.section-heading {
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 3vw, 1.85rem);
		font-weight: 600;
		color: var(--color-ink);
		margin: 0.5rem 0 0;
		line-height: 1.3;
	}

	.items-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	@media (max-width: 640px) {
		.items-grid {
			grid-template-columns: 1fr;
		}
	}

	.event-card {
		background: rgba(184, 220, 228, 0.55);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		padding: 1.5rem 1.5rem 1.5rem 1.25rem;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.5);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
		border-left: 6px solid var(--color-accent);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.event-card:hover {
		transform: translateX(6px);
		box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
	}

	.auction-card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.auction-card-wide {
		grid-column: 1 / -1;
	}

	.auction-photo {
		border-radius: 8px;
		overflow: hidden;
		background: #fff;
		aspect-ratio: 3 / 4;
		margin-bottom: 0.35rem;
	}

	.auction-photo img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
		display: block;
	}

	.auction-photo-wide {
		aspect-ratio: 4 / 3;
	}

	.auction-lot {
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
	}

	.auction-item-title {
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 600;
		color: var(--color-ink);
		line-height: 1.2;
		margin: 0;
	}

	.auction-item-desc {
		font-family: var(--font-body);
		font-size: 0.9375rem;
		color: var(--color-sepia);
		line-height: 1.6;
		margin: 0;
		flex: 1;
	}

	.auction-bid-row {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		margin-top: 0.25rem;
		padding-top: 0.75rem;
		border-top: 1px solid rgba(255, 255, 255, 0.5);
	}

	.auction-label {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--color-sepia);
	}

	.auction-price {
		font-family: var(--font-body);
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--color-accent);
	}

	.info-card {
		padding: 1.75rem 1.5rem 1.75rem 1.25rem;
	}

	.info-title {
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 600;
		color: var(--color-ink);
		margin: 0 0 1rem;
	}

	.info-list {
		padding-left: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.info-list li {
		font-family: var(--font-body);
		font-size: 1rem;
		color: var(--color-ink);
		line-height: 1.6;
	}

	.merchandise-note {
		font-family: var(--font-body);
		font-size: 1rem;
		color: var(--color-ink);
		line-height: 1.7;
		margin: 0;
	}

	@media (max-width: 768px) {
		.hero {
			padding: 3rem 1rem;
		}
		.auction-content {
			padding: 2.5rem 1rem;
		}
		.event-card:hover {
			transform: none;
		}
	}
</style>
