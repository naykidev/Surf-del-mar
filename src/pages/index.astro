---
import BaseLayout from '../layouts/BaseLayout.astro';
import DynamicPageBlocks from '../components/DynamicPageBlocks.astro';
import { getZeffyDonationUrl } from '../config/siteLinks';

const zeffyDonateUrl = getZeffyDonationUrl();
---

<BaseLayout
	title="Surf Del Mar Festival"
	description="Celebrating the sport and the culture. Preserving the stories and the spirit. Del Mar Historical Society Surfing Festival."
	pageKey="home"
>
	<!-- Hero: full-screen with sunset/surfer background -->
	<section class="hero-long" aria-label="Surf Del Mar Festival">
		<img
			src="/surfdelmar.png"
			alt=""
			class="hero-long-bg"
			width="1200"
			height="800"
			fetchpriority="high"
			data-original-src="/surfdelmar.png"
			onerror="this.onerror=null;this.src=this.getAttribute('data-original-src')||'/surfdelmar.png';"
		/>
		<div class="hero-long-overlay"></div>
		<div class="hero-long-content">
			<h1 class="hero-long-title" data-editable="home.hero.title">Surf Del Mar Festival</h1>
			<p class="hero-long-subtitle" data-editable="home.hero.subtitle">October 8–11, 2026</p>
			<div class="hero-long-divider"></div>
			<p class="hero-long-tagline" data-editable="home.hero.tagline1">Celebrating the Sport and the Culture</p>
			<p class="hero-long-tagline" data-editable="home.hero.tagline2">Preserving the Stories and the Spirit</p>
		</div>
	</section>

	<!-- Highlights of the Festival -->
	<section class="highlights-section" aria-labelledby="highlights-heading">
		<div class="highlights-inner">
			<h2 id="highlights-heading" class="highlights-heading" data-editable="home.highlights.heading">Highlights of the Festival</h2>
			<div class="highlights-divider"></div>

			<!-- En Fuego party -->
			<article class="highlight-card">
				<div class="highlight-media">
					<img src="/enfuego.jpg" alt="En Fuego Cantina in Del Mar" class="highlight-img" width="1400" height="1050" loading="lazy" />
				</div>
				<div class="highlight-body">
					<p class="highlight-kicker" data-editable="home.highlight.enfuego.kicker">Friday Night · October 9th</p>
					<h3 class="highlight-title" data-editable="home.highlight.enfuego.title">Surf Del Mar Party at En Fuego</h3>
					<p class="highlight-text" data-editable="home.highlight.enfuego.body">Join us for a Surf Del Mar Party at En Fuego Restaurant, Friday night, October 9th from 5:00 to 9:00 pm. Tower 7 will be providing the music! The party at En Fuego Restaurant is open to everyone, but for food and drinks, you're on your own!</p>
				</div>
			</article>

			<!-- Bustin' Down the Door screening -->
			<article class="highlight-card highlight-card-reverse">
				<div class="highlight-media">
					<img src="/bustin-down-the-door.png" alt="Bustin' Down the Door screening poster with Shaun Tomson" class="highlight-img highlight-img-poster" width="663" height="1024" loading="lazy" />
				</div>
				<div class="highlight-body">
					<p class="highlight-kicker" data-editable="home.highlight.bustindownthedoor.kicker">Friday · October 9th</p>
					<h3 class="highlight-title" data-editable="home.highlight.bustindownthedoor.title">Bustin' Down the Door Screening with Q&amp;A</h3>
					<p class="highlight-text" data-editable="home.highlight.bustindownthedoor.body">Celebrating the 50th anniversary of a surf revolution — join surfing legend Shaun Tomson for a screening of Bustin' Down the Door with Q&amp;A, Friday, October 9th from 5:00 to 7:30 pm at St Peter's Parish Hall, 334 14th Street, Del Mar. Free Admission!</p>
				</div>
			</article>

			<!-- Endless Summer screening -->
			<article class="highlight-card">
				<div class="highlight-media">
					<img src="/filmfestival.jpg" alt="The Endless Summer film poster by Bruce Brown" class="highlight-img highlight-img-poster" width="178" height="252" loading="lazy" />
				</div>
				<div class="highlight-body">
					<p class="highlight-kicker" data-editable="home.highlight.endlesssummer.kicker">Saturday Night · October 10th</p>
					<h3 class="highlight-title" data-editable="home.highlight.endlesssummer.title">The Endless Summer on the Lawn</h3>
					<p class="highlight-text" data-editable="home.highlight.endlesssummer.body">Bring your friends, family and a picnic for a screening of Bruce Brown's classic film, The Endless Summer, Saturday night, October 10th, on the lawn at Powerhouse Park, Del Mar. The show starts between 6:30 and 7:00 pm…as soon as it's dark! Free Admission!</p>
				</div>
			</article>

			<!-- Jeff Divine book signing -->
			<article class="highlight-card highlight-card-triple">
				<div class="highlight-media">
					<img src="/jeff-divine-highlight.png" alt="Jeff Divine" class="highlight-img highlight-img-poster" width="819" height="1024" loading="lazy" />
				</div>
				<div class="highlight-body">
					<p class="highlight-kicker" data-editable="home.highlight.jeffdivine.kicker">Sunday · October 11th</p>
					<h3 class="highlight-title" data-editable="home.highlight.jeffdivine.title">Jeff Divine Book Signing</h3>
					<p class="highlight-text" data-editable="home.highlight.jeffdivine.body">Meet legendary surf Photographer Jeff Divine and get a copy of his newest book "Divine Surf!" Sunday, October 11th at L'Auberge Hotel, 11:00 am.</p>
				</div>
				<div class="highlight-media highlight-media-book">
					<img src="/divine-surf-book.png" alt="Divine Surf by Jeff Divine book cover" class="highlight-img highlight-img-poster highlight-img-book" width="819" height="1024" loading="lazy" />
				</div>
			</article>
		</div>
	</section>

	<!-- Reunion: two-column -->
	<section class="reunion-section">
		<div class="reunion-container">
			<div class="reunion-col reunion-col-image">
				<div class="reunion-poster-wrap">
					<img src="/Poster.webp" alt="Surf Del Mar Festival poster by John Van Hamersveld" class="reunion-poster" width="600" height="900" />
					<a href="https://www.post-future.com/" target="_blank" rel="noopener noreferrer" class="reunion-poster-btn">See more of John Van Hamersveld's work.</a>
				</div>
			</div>
			<div class="reunion-col reunion-col-text">
				<p class="reunion-body" data-editable="home.reunion.body">
					SURF DEL MAR FESTIVAL is more than a festival—it's a Reunion, decades in the making. It brings together generations of surfers, storytellers, artists, musicians, authors and filmmakers for a one-of-a-kind event celebrating the sport, the culture, the legacy and the surfing history of Del Mar and the surrounding communities.
				</p>
				<p class="reunion-join" data-editable="home.reunion.join">JOIN US OVER FOUR UNFORGETTABLE DAYS</p>
				<div class="calendar-callout">
					<p class="calendar-callout-dates" data-editable="home.reunion.dates">October 8–11, 2026 – Del Mar, California</p>
				</div>
				<p class="reunion-tagline" data-editable="home.reunion.tagline">Come Be A Part Of The History and The Fun When Surfers Come Together Again</p>
			</div>
		</div>
	</section>

	<DynamicPageBlocks pageKey="home" />

	<!-- Support / donate (Zeffy); copy editable when logged in as admin -->
	<section class="support-section" aria-labelledby="support-heading">
		<div class="support-inner">
			<h2 id="support-heading" class="support-heading" data-editable="home.support.heading">Support Surf Del Mar Festival</h2>
			<p class="support-text" data-editable="home.support.body">
				Help us keep this festival and our coastal heritage programs going. Donations are processed securely through Zeffy.
			</p>
			<a
				href={zeffyDonateUrl}
				class="btn-support"
				target="_blank"
				rel="noopener noreferrer"
			>
				Donate with Zeffy
			</a>
		</div>
	</section>

	<!-- Don Hansen Tribute (compact) -->
	<section class="hansen-compact" aria-labelledby="hansen-heading">
		<div class="hansen-compact-inner">
			<div class="hansen-compact-photo">
				<img src="/hanson.png" alt="Don Hansen" width="942" height="910" loading="lazy" />
				<span class="hansen-compact-caption">Don Hansen (1936–2026)</span>
			</div>
			<div class="hansen-compact-text">
				<h2 id="hansen-heading" class="hansen-compact-heading">A Tribute to Don Hansen</h2>
				<p>Donald Hansen — entrepreneur, athlete and adventurer — passed away on March 28th, 2026 at the age of 89. Born in 1936 in Aberdeen, South Dakota, Don discovered surfing in his early California years and, in 1960, founded Hansen Surfboards near Cardiff Reef in Encinitas. The shop became one of the best-known names in California surf culture — a gathering place for generations of surfers, skaters, skiers and local families, with Don at its heart.</p>
				<p>He chased challenge everywhere: big Hawaiian waves when that frontier was still young, national titles and world records as captain of the Airfreight skydiving team, and team roping on the mountain trails of Big Sky, Montana. What set Don apart was not just his willingness to take risks, but his willingness to care — a strong spirit, a memorable sense of humor, and a habit of believing in people before they fully believed in themselves.</p>
			</div>
		</div>
	</section>

	<!-- Free admission note -->
	<section class="free-note-section" aria-label="Admission">
		<p class="home-free" data-editable="home.free">
			ALL EVENTS WILL BE FREE AND OPEN TO THE PUBLIC, WELCOMING RESIDENTS, VISITORS, SURFERS, FAMILIES AND ANYONE WHO SHARES A LOVE OF THE OCEAN
			<br /><br />
			(The Party at En Fuego Restaurant is open to everyone, but for food and drinks, you're on your own!)
		</p>
	</section>

	<!-- Final CTA -->
	<section class="cta-section">
		<a href="/schedule/" class="btn-schedule">VIEW FULL EVENT SCHEDULE</a>
	</section>
</BaseLayout>

<style>
	/* --- Coastal Vintage palette (use vars where existing) --- */
	.hero-long {
		position: relative;
		min-height: 80vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: var(--color-ink);
		text-align: center;
		color: var(--color-cream);
		overflow: hidden;
	}

	.hero-long-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
		filter: brightness(1.12);
		z-index: 0;
	}

	.hero-long-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(0deg, rgba(30,46,46,0.6) 0%, rgba(30,46,46,0.25) 50%, transparent 100%);
		z-index: 1;
		pointer-events: none;
	}

	.hero-long-content {
		position: relative;
		z-index: 2;
		max-width: 720px;
		padding: 2rem 1.5rem;
	}

	.hero-long-title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 10vw, 5.5rem);
		font-weight: 700;
		letter-spacing: 0.02em;
		margin: 0 0 0.25rem 0;
		line-height: 1.05;
		text-shadow: 0 2px 24px rgba(0,0,0,0.4);
	}

	.hero-long-subtitle {
		font-family: var(--font-body);
		font-size: clamp(2.25rem, 7.5vw, 4.25rem);
		font-weight: 600;
		letter-spacing: 0.45em;
		margin: 0 0 1.25rem 0;
		opacity: 0.95;
		text-shadow: 0 1px 12px rgba(0,0,0,0.3);
	}

	.hero-long-divider {
		width: 120px;
		height: 2px;
		background: linear-gradient(90deg, transparent, rgba(229,240,242,0.9), transparent);
		margin: 0 auto 1.5rem auto;
	}

	.hero-long-tagline {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 4.5vw, 2.25rem);
		font-weight: 500;
		margin: 0 0 0.35rem 0;
		opacity: 0.95;
		text-shadow: 0 1px 8px rgba(0,0,0,0.3);
	}

	/* --- Reunion two-column --- */
	.reunion-section {
		background: linear-gradient(180deg, var(--color-cream) 0%, var(--color-sand) 50%, var(--color-foam) 100%);
		padding: 4rem 2rem;
	}

	.reunion-container {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
		max-width: 1100px;
		margin: 0 auto;
	}

	@media (max-width: 768px) {
		.reunion-container {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.reunion-col-image {
			order: 1;
		}
		.reunion-col-text {
			order: 2;
		}
	}

	.reunion-poster-wrap {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 1.25rem;
	}

	.reunion-poster-btn {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--color-cream);
		background: var(--color-ink);
		border-radius: 50px;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.reunion-poster-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
	}

	.reunion-poster {
		width: 100%;
		max-width: 420px;
		height: auto;
		display: block;
		border-radius: 6px;
		box-shadow: 0 20px 50px rgba(0,0,0,0.18), 0 8px 24px rgba(0,0,0,0.12);
		transform: rotate(-2deg);
		transition: transform 0.35s ease, box-shadow 0.35s ease;
	}

	.reunion-poster-wrap:hover .reunion-poster {
		transform: rotate(0deg);
		box-shadow: 0 24px 56px rgba(0,0,0,0.2);
	}

	.reunion-heading {
		font-family: var(--font-display);
		font-size: clamp(1.85rem, 4vw, 2.35rem);
		font-weight: 600;
		color: var(--color-ink);
		margin: 0 0 1rem 0;
		line-height: 1.2;
	}

	.reunion-body {
		font-family: var(--font-body);
		font-size: 1.1rem;
		color: var(--color-ink);
		line-height: 1.75;
		margin: 0 0 1.5rem 0;
		max-width: 48ch;
	}

	.reunion-join {
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-ink);
		margin: 0 0 1rem 0;
		line-height: 1.4;
	}

	.reunion-tagline {
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 600;
		color: var(--color-ink);
		line-height: 1.45;
		margin: 1.25rem 0 0 0;
		max-width: 42ch;
	}

	.calendar-callout {
		background: rgba(204,228,232,0.75);
		border-left: 4px solid #c9a227;
		padding: 1.25rem 1.5rem;
		border-radius: 0 10px 10px 0;
		box-shadow: 0 4px 20px rgba(0,0,0,0.06);
	}

	.calendar-callout-label {
		font-family: var(--font-body);
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-sepia);
		margin: 0 0 0.35rem 0;
	}

	.calendar-callout-dates {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-ink);
		margin: 0;
		line-height: 1.35;
	}

	/* --- Highlights of the Festival --- */
	.highlights-section {
		background: linear-gradient(180deg, var(--color-foam) 0%, var(--color-cream) 100%);
		padding: 4.5rem 2rem;
	}

	.highlights-inner {
		max-width: 1000px;
		margin: 0 auto;
	}

	.highlights-heading {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 600;
		color: var(--color-ink);
		text-align: center;
		margin: 0;
		line-height: 1.2;
	}

	.highlights-divider {
		width: 60px;
		height: 3px;
		background: #c9a227;
		margin: 1rem auto 3rem;
	}

	.highlight-card {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 2.5rem;
		align-items: center;
		background: var(--color-cream);
		border-radius: 12px;
		padding: 1.75rem;
		box-shadow: 0 10px 30px rgba(0,0,0,0.08);
		border: 1px solid rgba(0,0,0,0.05);
	}

	.highlight-card + .highlight-card {
		margin-top: 2.5rem;
	}

	.highlight-card-reverse .highlight-media {
		order: 2;
	}

	.highlight-card-triple {
		grid-template-columns: 0.85fr 1.15fr 0.85fr;
		gap: 1.75rem;
	}

	.highlight-img-book {
		object-fit: contain;
		background: transparent;
		box-shadow: none;
	}

	.highlight-media {
		display: flex;
		justify-content: center;
	}

	.highlight-img {
		width: 100%;
		height: auto;
		border-radius: 8px;
		box-shadow: 0 12px 30px rgba(0,0,0,0.15);
		object-fit: cover;
	}

	.highlight-img-poster {
		max-width: 300px;
		box-shadow: 0 16px 36px rgba(0,0,0,0.22);
	}

	.highlight-kicker {
		font-family: var(--font-body);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-sand-dark);
		margin: 0 0 0.5rem 0;
	}

	.highlight-title {
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 3.5vw, 2rem);
		font-weight: 600;
		color: var(--color-ink);
		margin: 0 0 0.9rem 0;
		line-height: 1.2;
	}

	.highlight-text {
		font-family: var(--font-body);
		font-size: 1.1rem;
		line-height: 1.7;
		color: var(--color-ink);
		margin: 0;
	}

	@media (max-width: 768px) {
		.highlights-section {
			padding: 3rem 1rem;
		}
		.highlight-card,
		.highlight-card-reverse,
		.highlight-card-triple {
			grid-template-columns: 1fr;
			gap: 1.25rem;
			padding: 1.25rem;
		}
		.highlight-card-reverse .highlight-media {
			order: 0;
		}
		.highlight-img-poster {
			max-width: 220px;
		}
		.highlight-text {
			font-size: 1rem;
		}
	}

	/* --- Don Hansen Tribute (compact) --- */
	.hansen-compact {
		background: var(--color-cream);
		padding: 3.5rem 2rem;
		border-top: 1px solid rgba(0,0,0,0.06);
		border-bottom: 1px solid rgba(0,0,0,0.05);
	}

	.hansen-compact-inner {
		max-width: 900px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 220px 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.hansen-compact-photo {
		text-align: center;
	}

	.hansen-compact-photo img {
		width: 100%;
		height: auto;
		border-radius: 4px;
		box-shadow: 10px 10px 0px var(--color-sand);
		border: 1px solid rgba(0,0,0,0.1);
	}

	.hansen-compact-caption {
		display: block;
		font-family: var(--font-body);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-top: 1rem;
		color: var(--color-sepia);
	}

	.hansen-compact-heading {
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 3.5vw, 2.1rem);
		font-weight: 600;
		color: var(--color-ink);
		margin: 0 0 1rem 0;
		line-height: 1.2;
	}

	.hansen-compact-text p {
		font-family: var(--font-body);
		font-size: 1rem;
		line-height: 1.7;
		color: var(--color-ink);
		margin: 0 0 1rem 0;
	}

	.hansen-compact-text p:last-child {
		margin-bottom: 0;
	}

	@media (max-width: 768px) {
		.hansen-compact {
			padding: 2.5rem 1rem;
		}
		.hansen-compact-inner {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
		.hansen-compact-photo {
			max-width: 240px;
			margin: 0 auto;
		}
	}

	/* --- Support / donate --- */
	.support-section {
		background: linear-gradient(180deg, var(--color-sand) 0%, var(--color-cream) 100%);
		padding: 3.5rem 2rem;
		text-align: center;
		border-top: 1px solid rgba(26, 46, 46, 0.08);
		border-bottom: 1px solid rgba(26, 46, 46, 0.06);
	}

	.support-inner {
		max-width: 560px;
		margin: 0 auto;
	}

	.support-heading {
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		font-weight: 600;
		color: var(--color-ink);
		margin: 0 0 1rem 0;
		line-height: 1.2;
	}

	.support-text {
		font-family: var(--font-body);
		font-size: 1.05rem;
		line-height: 1.65;
		color: var(--color-sepia);
		margin: 0 0 1.5rem 0;
	}

	.btn-support {
		display: inline-block;
		padding: 0.95rem 2rem;
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-ink);
		background: var(--color-cream);
		border: 2px solid var(--color-sand-dark);
		border-radius: 50px;
		box-shadow: 0 2px 14px rgba(30, 122, 122, 0.2);
		transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.2s ease;
	}

	.btn-support:hover {
		transform: translateY(-2px);
		background: #fff;
		box-shadow: 0 6px 22px rgba(30, 122, 122, 0.28);
	}

	/* --- Final CTA --- */
	.cta-section {
		background: linear-gradient(180deg, var(--color-foam) 0%, var(--color-sand) 100%);
		padding: 4rem 2rem;
		text-align: center;
	}

	.free-note-section {
		background: var(--color-foam);
		padding: 2.5rem 2rem 0;
		text-align: center;
	}

	.home-free {
		max-width: 720px;
		margin: 0 auto;
		font-family: var(--font-body);
